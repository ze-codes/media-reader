# Copy this file to .env and select one provider: openrouter,
# openai-compatible, codex-cli, or claude-cli.
LLM_PROVIDER=openrouter

# Paste the exact provider model ID. Media Reader does not maintain a model catalog.
LLM_MODEL=provider/model-id

# Required for openai-compatible. OpenRouter has a built-in base URL.
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# Keep real keys in your local .env only.
# LLM_API_KEY=replace-with-provider-key

# OpenRouter accepts this migration alias when LLM_API_KEY is unset.
# OPENROUTER_API_KEY=replace-with-openrouter-key

# Optional non-secret OpenRouter attribution headers.
# LLM_APP_URL=https://reader.example.com
# LLM_APP_NAME=Media Reader

# Optional binary overrides for native CLI providers. Authenticate with the
# official CLI before starting Media Reader; Media Reader does not read auth files.
# LLM_CODEX_BIN=codex
# LLM_CLAUDE_BIN=claude

# Persistent state. Relative paths are resolved from the application checkout.
MEDIA_READER_DATA_DIR=./data
MEDIA_READER_DB_PATH=./data/media-reader.db

# HTTP server.
PORT=8099

# Optional TranscriptAPI. Without a key, Media Reader falls back to captions
# and local Whisper. Keep the default endpoint unless using a compatible service.
# TRANSCRIPT_API_KEY=replace-with-transcriptapi-key
# TRANSCRIPT_API_BASE_URL=https://transcriptapi.com/api/v2
# TRANSCRIPT_API_TIMEOUT_MS=45000

# Transcription backend: faster-whisper (default) or whisper.cpp.
YT_TRANSCRIBE_BACKEND=faster-whisper
YT_FAST_WHISPER_PYTHON=python3
YT_FAST_WHISPER_MODEL=large-v3-turbo
YT_FAST_WHISPER_MODEL_DIR=./data/faster-whisper
YT_FAST_WHISPER_DEVICE=cpu
YT_FAST_WHISPER_COMPUTE_TYPE=int8
YT_FAST_WHISPER_BEAM_SIZE=5
YT_FAST_WHISPER_LANGUAGE=auto
YT_FAST_WHISPER_TASK=transcribe
YT_FAST_WHISPER_VAD_FILTER=1

# whisper.cpp settings, used only when YT_TRANSCRIBE_BACKEND=whisper.cpp.
# YT_WHISPER_MODEL=ggml-small.bin
# YT_WHISPER_LANGUAGE=auto
# YT_WHISPER_TRANSLATE=0

# Optional delay between YouTube jobs, in milliseconds.
# YT_YOUTUBE_JOB_DELAY_MS=0

# Optional directory containing Cookie-Editor JSON profiles. Native installs
# read this path directly. Compose uses the same host setting for a read-only
# bind at /cookies; the container runtime falls back to /cookies. Use filenames
# beginning with youtube or xiaohongshu.
MEDIA_READER_COOKIE_DIR=./cookies
